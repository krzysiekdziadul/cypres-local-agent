{
  "name": "ai-local-codellama-agent",
  "version": "1.0.0",
  "description": "Interactive Node.js agent communicating with local Code Llama model via Ollama",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "dev": "node agent.js",
    "react:dev": "vite",
    "react:build": "vite build",
    "react:preview": "vite preview",
    "setup": "setup.bat",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f ollama-ai",
    "pull-model": "docker exec ollama-codellama ollama pull qwen2.5-coder:1.5b",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:report": "cypress run --reporter cypress-multi-reporters --reporter-options configFile=reporter-config.json",
    "test": "cypress run"
  },
  "keywords": [
    "ollama",
    "codellama",
    "ai",
    "cypress",
    "coding-assistant"
  ],
  "author": "Krzysztof Dziadul",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "cypress": "^13.6.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-multi-reporters": "^2.0.5",
    "mocha-junit-reporter": "^2.2.1",
    "vite": "^4.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
